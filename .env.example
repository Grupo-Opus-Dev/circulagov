# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env (ele já está no .gitignore).
#
# As variáveis marcadas com [PROD] só importam em produção. Em
# desenvolvimento, com DEBUG=True, podem ficar como estão.

DEBUG=True
SECRET_KEY=troque-por-uma-chave-secreta-gerada

# Gere a sua com:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
CHAVE_CIFRAGEM_2FA=troque-por-uma-chave-gerada-de-32-bytes

# Chave que assina o log de seguranca. Gere com o mesmo comando acima,
# mas use um valor DIFERENTE da CHAVE_CIFRAGEM_2FA.
CHAVE_INTEGRIDADE_LOGS=troque-por-outra-chave-gerada-de-32-bytes

DB_NAME=circulagov_db
DB_USER=circulagov_user
DB_PASSWORD=SEU_PASSWORD_AQUI
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------
# [PROD] Domínio
# ---------------------------------------------------------------------
# Em produção, DEBUG=False e estas duas precisam conter o domínio real.
# Sem CSRF_TRUSTED_ORIGINS, o Django recusa todo POST vindo de HTTPS
# atrás do proxy, e login e consentimento param de funcionar.

# ALLOWED_HOSTS=circulagov.nossoprojeto.app.br
# CSRF_TRUSTED_ORIGINS=https://circulagov.nossoprojeto.app.br

# ---------------------------------------------------------------------
# [PROD] E-mail da recuperação de senha
# ---------------------------------------------------------------------
# Sem isto, o backend padrão é o de console: o e-mail sai no log do
# container em vez de chegar no destinatário, e a recuperação de senha
# não funciona de verdade.
#
# Com Gmail, EMAIL_HOST_PASSWORD NÃO é a senha da conta. É uma "senha de
# app", gerada em myaccount.google.com/apppasswords, que exige 2FA ativo
# na conta Google.

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-endereco@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app-de-16-caracteres
# DEFAULT_FROM_EMAIL=CirculaGov <seu-endereco@gmail.com>

# ---------------------------------------------------------------------
# [PROD] Gunicorn
# ---------------------------------------------------------------------
# Padrão é 3. Em máquina com mais CPU, a regra usual é 2 x núcleos + 1.

# GUNICORN_WORKERS=3
